Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Occupancy map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.3
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR band (/scan)
      Enabled: true
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 239; 239; 120
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/TF
      Name: Robot pose
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: false
        base_link:
          Value: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Color: 45; 211; 167
      Line Style: Billboards
      Line Width: 0.06
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Roam status (grid, goal, alternatives, status line)
      Enabled: true
      Topic:
        Value: /exploration/status_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Mission candidates (live_mission)
      Enabled: true
      Topic:
        Value: /live_mission/candidate_markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Stairs (Pi YOLO + RGB-D)
      Enabled: true
      Topic:
        Value: /group8pi/stair_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down map
      Scale: 60
Window Geometry:
  Width: 1200
  Height: 860
